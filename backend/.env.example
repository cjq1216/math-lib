# 应用
APP_NAME=math-bank-backend
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# 安全：生产环境必须替换为随机密钥
JWT_SECRET_KEY=dev-secret-please-change-in-production-32chars-min
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# 数据库
DATABASE_URL=sqlite:///./data/math_bank.db
DB_ECHO=false
# PostgreSQL 示例（需安装 psycopg）：
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/math_bank

# 媒体
MEDIA_ROOT=./data/images
MEDIA_BASE_URL=http://localhost:8000/static

# LLM
LLM_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-Text-01
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Embedding
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.minimaxi.com/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# 日志
LOG_LEVEL=INFO
LOG_FILE=./data/logs/app.log

# CORS（JSON 数组）
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
